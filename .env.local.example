# dima-frontend — Next.js public env (bu şablonu .env.local'a kopyala)
#
# Backend taban URL'i. `pnpm dev` (localtld) ile çalışırken localtld domaini,
# aksi halde localhost fallback kullanılır.
NEXT_PUBLIC_API_URL=http://backend.dima.localtld
# localtld yoksa:
# NEXT_PUBLIC_API_URL=http://localhost:8000
