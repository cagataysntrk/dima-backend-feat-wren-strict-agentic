{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "ANALYZE",
        "DIMA_LEGAL_APPROVED"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "quality:ui": {
      "dependsOn": []
    },
    "e2e": {
      "dependsOn": [],
      "cache": false,
      "env": ["FRONTEND_URL", "BACKEND_URL", "CHROME_BIN", "CDP_PORT", "HEADFUL", "DIMA_E2E_SESSION", "DIMA_E2E_SESSION_COOKIE"]
    },
    "e2e:marketing": {
      "dependsOn": [],
      "cache": false,
      "env": ["MARKETING_FRONTEND_URL", "MARKETING_CDP_PORT"]
    },
    "codegen:check": {
      "dependsOn": [],
      "cache": false,
      "env": ["DIMA_BACKEND_PATH", "DIMA_BACKEND_URL"]
    }
  },
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["BACKEND_ORIGIN", "RESEND_API_KEY", "VERCEL_ENV", "DIMA_LEGAL_APPROVED", "FRONTEND_URL", "BACKEND_URL", "CHROME_BIN", "CDP_PORT", "HEADFUL", "DIMA_E2E_SESSION", "DIMA_E2E_SESSION_COOKIE", "MARKETING_FRONTEND_URL", "MARKETING_CDP_PORT"]
}
