{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "ANALYZE"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "quality:ui": {
      "dependsOn": []
    },
    "codegen:check": {
      "dependsOn": [],
      "cache": false,
      "env": ["DIMA_BACKEND_PATH", "DIMA_BACKEND_URL"]
    }
  },
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["BACKEND_ORIGIN", "RESEND_API_KEY", "VERCEL_ENV"]
}
