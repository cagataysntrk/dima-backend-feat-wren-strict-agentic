{
  "name": "@dima/web",
  "version": "0.1.0",
  "private": true,
  "localtld": "frontend.dima",
  "scripts": {
    "dev": "if command -v localtld >/dev/null 2>&1; then localtld run -- next dev; else next dev; fi",
    "dev:plain": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "e2e": "bun run e2e:marketing && node e2e/browser-e2e.mjs",
    "e2e:marketing": "node e2e/marketing-smoke.mjs",
    "quality:ui": "ui-craft-detect \"src/app/(marketing)\" --fail-on error && ui-craft-detect src/components/marketing --fail-on error"
  },
  "dependencies": {
    "@dima/api-client": "workspace:*",
    "@dima/contracts": "workspace:*",
    "@dima/domain": "workspace:*",
    "@dima/genui": "workspace:*",
    "@openuidev/lang-core": "0.2.10",
    "@openuidev/react-lang": "0.2.9",
    "@tanstack/react-query": "^5.101.2",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.26.0",
    "mammoth": "^1.12.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.4.296",
    "radix-ui": "^1.6.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.4.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "resend": "^6.18.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.13",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@abdullahharunozturk/localtld": "^0.1.0"
  },
  "devDependencies": {
    "@dima/eslint-config": "workspace:*",
    "@dima/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "ui-craft-detect": "0.11.0",
    "vitest": "^4.1.10"
  }
}
