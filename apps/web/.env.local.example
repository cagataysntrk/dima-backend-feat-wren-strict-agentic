# dima-frontend — Next.js env (bu şablonu .env.local'a kopyala)
#
# Backend origin — SERVER-SIDE (browser'a SIZMAZ). Next '/api/*' isteklerini buraya
# proxy'ler → same-origin cookie + CORS'suz + backend URL gizli (ADR-0012 rewrite-proxy).
# `pnpm dev` (localtld) ile localtld domaini, aksi halde localhost fallback.
BACKEND_ORIGIN=http://backend.dima.localtld
# localtld yoksa:
# BACKEND_ORIGIN=http://localhost:8000
# LOKAL backend AYAĞA KALDIRMADAN canlıya bağlanmak için (frontend ekibi akışı —
# rewrite-proxy sayesinde CORS'suz, cookie sorunsuz):
# BACKEND_ORIGIN=https://dima-api.upcytech.com

# Refresh cookie adı — backend DIMA_COOKIE_NAME ile SENKRON tutulur (src/proxy.ts okur).
# Varsayılan iki tarafta da "dima_refresh"; backend değiştirirse burada da değiştir.
# NEXT_PUBLIC_SESSION_COOKIE=dima_refresh

# Public marketing origin — canonical URL, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://dima.upcytech.com

# Set true only for an approved production deployment. Vercel production is
# indexed automatically; previews and local environments remain noindex.
# NEXT_PUBLIC_INDEXING_ENABLED=false

# Demo request delivery. Keep the API key server-only. CONTACT_FROM_EMAIL must
# be a sender verified in Resend.
# RESEND_API_KEY=re_...
# CONTACT_FROM_EMAIL=dima <contact@notifications.upcytech.com>
# CONTACT_TO_EMAIL=contact@upcytech.com
