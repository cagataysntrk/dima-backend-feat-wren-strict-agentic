# OpenUI playground — generative UI üretimi için sağlayıcı ayarları.
# Kopyala: cp .env.local.example .env.local
#
# NOT: bunlar YALNIZ playground içindir. Üretimde arayüz üretimi
# `dima-backend` tarafında olur; sağlayıcı anahtarı Next sürecinde durmaz.

# Zorunlu. Anahtar yoksa /api/chat 503 döner (build yine de geçer).
OPENAI_API_KEY=

# İsteğe bağlı. OpenAI-uyumlu herhangi bir uç: Azure OpenAI, OpenRouter,
# Groq, ya da kendi sunucunda koşan vLLM/Ollama. Boş bırakılırsa SDK'nın
# varsayılanı kullanılır. On-prem kurulumda değişen tek satır budur.
# OPENAI_BASE_URL=http://localhost:11434/v1

# İsteğe bağlı. Varsayılan: gpt-5.2
# OPENAI_MODEL=
