{
  "name": "@dima/openui",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "if command -v localtld >/dev/null 2>&1; then localtld run -- next dev --port 3001; else next dev --port 3001; fi",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "genui:prompt": "node scripts/genui-prompt.mjs",
    "test": "vitest run",
    "dev:plain": "next dev --port 3001"
  },
  "dependencies": {
    "@dima/contracts": "workspace:*",
    "@dima/domain": "workspace:*",
    "@openuidev/lang-core": "0.2.10",
    "@openuidev/react-headless": "0.9.3",
    "@openuidev/react-lang": "0.2.9",
    "@openuidev/react-ui": "0.13.1",
    "next": "16.2.12",
    "openai": "^6.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "localtld": "genui.dima",
