{# dima e-posta base layout — marka header + gövde bloğu + footer. report/alarm bunu
   genişletir. MJML = responsive + Outlook/Gmail tutarlı; {{ }} otomatik HTML-escape. #}
<mjml>
  <mj-head>
    <mj-title>{{ e.title }}</mj-title>
    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="14px" color="#222222" line-height="1.5" />
    </mj-attributes>
    <mj-style>
      .data-table table { border-collapse:collapse; width:100%; }
      .data-table th { padding:6px 10px; text-align:left; font-size:12px; color:#6b7280;
        font-weight:600; border-bottom:2px solid #e5e7eb; }
      .data-table td { padding:6px 10px; text-align:left; font-size:13px;
        border-bottom:1px solid #f0f0f0; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f5">
    <mj-section padding="24px 0 0">
      <mj-column>
        <mj-text font-size="18px" font-weight="700" color="#0f172a" letter-spacing="0.5px">dima</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" border-radius="8px" padding="8px 24px 24px">
      <mj-column>
        {% block body %}{% endblock %}
      </mj-column>
    </mj-section>
    <mj-section padding="10px 0 24px">
      <mj-column>
        <mj-text font-size="11px" color="#9ca3af" align="center">
          dima · otomatik bildirim{% if e.period %} · {{ e.period }}{% endif %}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
