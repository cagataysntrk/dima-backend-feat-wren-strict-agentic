  "8f3cf3405fd6559d9fadf8e6dc5f5632#0": "{\n  \"adimlar\": [\n    {\n      \"fiil\": \"TREND\",\n      \"cube_query\": {\n        \"cube\": \"parti\",\n        \"measures\": [\"toplam_ciro\"],\n        \"period_expr\": \"geçen yıl\"\n      }\n    },\n    {\n      \"fiil\": \"ANLAT\",\n      \"kaynaklar\": [\"$1\"]\n    }\n  ]\n}",
