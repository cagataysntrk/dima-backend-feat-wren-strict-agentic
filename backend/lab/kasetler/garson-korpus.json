  "8f3cf3405fd6559d9fadf8e6dc5f5632#1": "{\n  \"adimlar\": [\n    {\n      \"fiil\": \"SORGU\",\n      \"cube_query\": {\n        \"cube\": \"parti\",\n        \"measures\": [\"toplam_ciro\"],\n        \"timeDimensions\": [\n          {\n            \"dimension\": \"tarih\",\n            \"granularity\": \"year\"\n          }\n        ],\n        \"period_expr\": \"geçen yıl ve ondan önceki yıl\"\n      }\n    },\n    {\n      \"fiil\": \"TREND\",\n      \"cube_query\": \"$1\"\n    },\n    {\n      \"fiil\": \"ANLAT\",\n      \"kaynaklar\": [\"$2\"]\n    }\n  ]\n}",
