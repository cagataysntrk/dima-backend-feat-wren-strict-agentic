# dima-backend configuration (prefix: DIMA_)

# --- Wren project / data source ---
# Path to a wren project directory that contains target/mdl.json
DIMA_PROJECT_DIR=demo/wren-project
DIMA_DATASOURCE=duckdb
# Connection info JSON (WITHOUT the "datasource" key). For the bundled demo:
DIMA_CONNECTION_INFO={"url": "demo/data", "format": "duckdb"}

# Example for a customer Postgres instead:
# DIMA_DATASOURCE=postgres
# DIMA_CONNECTION_INFO={"host":"localhost","port":5432,"database":"tekstil","user":"postgres","password":"...","schema":"public"}

# --- LLM sağlayıcı ---
# auto: anthropic → xai → gemini → groq → ollama (ayakta ise) → kural-tabanlı (ANAHTARSIZ).
# Açık değerler: auto | anthropic | xai | gemini | groq | ollama | rule
DIMA_LLM_PROVIDER=auto

# Anthropic (ücretli)
DIMA_ANTHROPIC_API_KEY=
DIMA_LLM_MODEL=claude-sonnet-4-6

# xAI Grok (OpenAI uyumlu: https://console.x.ai — hesapta kredi gerekir)
DIMA_XAI_API_KEY=
DIMA_XAI_MODEL=grok-4.5

# Google Gemini (ÜCRETSİZ katman; OpenAI-uyumlu endpoint) — https://aistudio.google.com
DIMA_GEMINI_API_KEY=
DIMA_GEMINI_MODEL=gemini-flash-latest

# Groq (ücretsiz key: https://console.groq.com) — OpenAI uyumlu
DIMA_GROQ_API_KEY=
DIMA_GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (tam yerel, anahtarsız: `brew install ollama` + `ollama pull qwen2.5-coder:7b`)
DIMA_OLLAMA_BASE_URL=http://localhost:11434/v1
DIMA_OLLAMA_MODEL=qwen2.5-coder:7b

# --- Zamanlanmış rapor teslim kanalları (ADR-0011) ---
# Bildirim in-app bell'e HER ZAMAN düşer; e-posta OPSİYONEL. Key boşsa e-posta
# kanalı sessizce atlanır (in-app teslim etkilenmez). Resend: https://resend.com
# (from adresi doğrulanmış domain olmalı). Ürün maili BACKEND'de yönetilir.
DIMA_RESEND_API_KEY=
DIMA_RESEND_FROM=dima <dima@upcytech.com>

# --- Guards / server ---
DIMA_MAX_RESULT_ROWS=1000
# localtld domainleri (pnpm dev → localtld run). localhost fallback da eklidir.
DIMA_CORS_ORIGINS=http://frontend.dima.localtld,http://localhost:3000

# --- Auth / control-plane (ADR-0014/0015; saka-standards 02/08) ---
# Auth HER ZAMAN zorunlu (korunan endpoint'ler token ister). Control-plane DB gerekir.
# Boş bırakılırsa lokal SQLite (logs/control_plane.db) — yalnız hızlı yerel/CI içindir.
# Local dev + prod: Postgres. Prod (Railway private network):
#   DIMA_DATABASE_URL=postgresql+psycopg://app_api:...@<host>:5432/dima
DIMA_DATABASE_URL=

# JWT — access ve refresh için FARKLI secret ZORUNLU (saka-standards 02).
# Üret: openssl rand -base64 48   (boşsa lokalde süreç-ömrü rastgele — restart oturumu düşürür)
DIMA_JWT_SECRET=
DIMA_JWT_REFRESH_SECRET=
# Admin plane'in AYRI secret çifti (ADR-0015 izolasyonu): public süreç ele geçse bile
# admin-api'ye geçerli token basamaz. PROD'da ZORUNLU ve public'ten farklı.
DIMA_ADMIN_JWT_SECRET=
DIMA_ADMIN_JWT_REFRESH_SECRET=
# DIMA_ACCESS_TTL_SECONDS=900        # 15 dk
# DIMA_REFRESH_TTL_SECONDS=604800    # 7 gün
# DIMA_REFRESH_GRACE_SECONDS=10      # paralel sekme refresh yarışı hoşgörüsü
# DIMA_REFRESH_FAMILY_MAX_SECONDS=2592000  # oturumun mutlak üst ömrü (30 gün)
# DIMA_LOGIN_MAX_ATTEMPTS=5          # pencere başına başarısız login sınırı
# DIMA_LOGIN_WINDOW_SECONDS=900

# MFA (TOTP). Enrollment: python -m control_plane.cli enroll-mfa --email ...
# PROD'da true: mfa_secret'sız superadmin admin plane'e giremez (ADR-0015 2FA zorunlu).
DIMA_REQUIRE_SUPERADMIN_MFA=false

# Superadmin'in ÜRÜN UI'ından (public plane) girişi YALNIZ bu IP'lerden yapılabilir
# (ADR-0015 K7: log-only + IP kapısı; boş = fail-closed, tamamen kapalı).
# Lokal dev: 127.0.0.1 (rewrite-proxy backend'e localhost'tan gelir).
# Prod: core ekibin statik IP'leri + DIMA_TRUST_FORWARDED_FOR=true (Cloudflare önünde).
DIMA_SUPERADMIN_IP_ALLOWLIST=127.0.0.1
DIMA_TRUST_FORWARDED_FOR=false

# Refresh cookie (HTTP-only). Prod'da secure=true (HTTPS); cross-subdomain için domain.
DIMA_COOKIE_SECURE=false
# DIMA_COOKIE_DOMAIN=.dima.upcytech.com
# Admin cookie SameSite: LOKAL admin UI → CANLI admin-api (dima-sadmin-api.upcytech.com)
# topolojisi CROSS-ORIGIN'dir → canlı admin-api'de "none" (+ COOKIE_SECURE=true) gerekir.
DIMA_ADMIN_COOKIE_SAMESITE=lax

# İlk superadmin seed'i (yalnız boş DB'de; DB'de superadmin varsa atlanır).
DIMA_BOOTSTRAP_SUPERADMIN_EMAIL=
DIMA_BOOTSTRAP_SUPERADMIN_PASSWORD=

# admin_app (dima-admin-api) — lokal superadmin UI (dima-admin-frontend) origin'leri.
DIMA_ADMIN_CORS_ORIGINS=http://admin.dima.localtld,http://localhost:3001,http://localhost:3000

# Müşteri DB bağlantı sırlarının AES-256-GCM anahtarı (base64 32 bayt; ADR-0017).
DIMA_CRED_KEK=
